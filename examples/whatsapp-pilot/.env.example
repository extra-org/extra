# Copy to .env in this directory. .env is gitignored; never commit real values.

# Model provider for agents.yml.
OPENAI_API_KEY=replace-with-your-model-key

# Storage: docker-compose.yml sets EXTRA_DB_URL to a file on a durable volume.
# For PostgreSQL instead:
# EXTRA_DB_BACKEND=postgres
# EXTRA_DB_URL=postgresql://user:password@host/database

# Stage 1 — webhook intake. Messages are stored; nothing is answered yet.
EXTRA_WHATSAPP_ENABLED=false
EXTRA_WHATSAPP_CONNECTION_ID=whatsapp
EXTRA_WHATSAPP_ACCOUNT_ID=replace-with-business-account-id
EXTRA_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
EXTRA_WHATSAPP_APP_SECRET=replace-with-meta-app-secret
EXTRA_WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token

# Stage 2 — worker. Requires stage 1. Answers are saved but not sent.
EXTRA_WHATSAPP_WORKER_ENABLED=false
EXTRA_WHATSAPP_ORGANIZATION_ID=replace-with-organization-id
EXTRA_WHATSAPP_IDENTITY_RESOLVER=whatsapp_identity:AllowlistIdentityResolver
# Path inside the container; docker-compose.yml sets this to /workspace/senders.json.
# WHATSAPP_PILOT_SENDERS_FILE=./senders.json

# Stage 3 — sending. Requires stage 2.
EXTRA_WHATSAPP_SENDER_ENABLED=false
# Pin the Graph API version your account supports (format vNN.0).
EXTRA_WHATSAPP_API_VERSION=replace-with-pinned-version
EXTRA_WHATSAPP_ACCESS_TOKEN=replace-with-system-user-access-token
EXTRA_WHATSAPP_SUPPORT_CONTACT=replace-with-support-contact

# Optional: seconds between `channel status:` log lines (default 60).
# EXTRA_WHATSAPP_STATUS_LOG_SECONDS=60
