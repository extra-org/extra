# Copy to .env in this directory and fill in. .env is gitignored.
#
# The only required value: the credential for the provider set in
# `defaults.model` in agents.yaml.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Switching provider is one edit in agents.yaml plus the matching key here:
#
#   provider: openai   -> OPENAI_API_KEY
#   provider: gemini   -> GEMINI_API_KEY
#   provider: bedrock  -> AWS credentials + region
#
# A local OpenAI-compatible server (Ollama, LM Studio, vLLM) works too — set
# provider: openai in agents.yaml and point the base URL here:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Optional — used by the bank_name resolver.
# BANK_NAME=Northwind Bank
